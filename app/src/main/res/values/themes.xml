<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Scontrino" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Launch theme: shows the logo on black, then switches to Theme.Scontrino. -->
    <style name="Theme.Scontrino.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Scontrino</item>
    </style>
</resources>
